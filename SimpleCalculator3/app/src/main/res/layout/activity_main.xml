<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="10dp"
    android:background="#1C1C1E">

    <TextView
        android:id="@+id/tvResult"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:textSize="36sp"
        android:textColor="#FFFFFF"
        android:gravity="end|bottom"
        android:padding="16dp"
        android:background="#2C2C2E"
        android:layout_marginBottom="10dp"
        android:text="@string/num_0"/>

    <!-- Строка 1 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="5dp"
        style="?android:attr/buttonBarStyle">

        <Button
            android:id="@+id/btnClear"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_weight="1"
            android:text="@string/btn_clear"
            android:textSize="24sp"
            android:textColor="#FFFFFF"
            android:background="#3A3A3C"
            android:layout_marginEnd="5dp"
            style="?android:attr/buttonBarButtonStyle"/>

        <Button
            android:id="@+id/btnSign"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_weight="1"
            android:text="@string/btn_sign"
            android:textSize="24sp"
            android:textColor="#FFFFFF"
            android:background="#3A3A3C"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            style="?android:attr/buttonBarButtonStyle"/>

        <Button
            android:id="@+id/btnPercent"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_weight="1"
            android:text="@string/btn_percent"
            android:textSize="24sp"
            android:textColor="#FFFFFF"
            android:background="#3A3A3C"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            style="?android:attr/buttonBarButtonStyle"/>

        <Button
            android:id="@+id/btnDiv"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_weight="1"
            android:text="@string/btn_divide"
            android:textSize="28sp"
            android:textColor="#FF9500"
            android:background="#3A3A3C"
            android:layout_marginStart="5dp"
            style="?android:attr/buttonBarButtonStyle"/>
    </LinearLayout>

    <!-- Строка 2 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="5dp"
        style="?android:attr/buttonBarStyle">

        <Button
            android:id="@+id/btn7"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_weight="1"
            android:text="@string/num_7"
            android:textSize="28sp"
            android:textColor="#FFFFFF"
            android:background="#505055"
            android:layout_marginEnd="5dp"
            style="?android:attr/buttonBarButtonStyle"/>

        <Button
            android:id="@+id/btn8"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_weight="1"
            android:text="@string/num_8"
            android:textSize="28sp"
            android:textColor="#FFFFFF"
            android:background="#505055"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            style="?android:attr/buttonBarButtonStyle"/>

        <Button
            android:id="@+id/btn9"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_weight="1"
            android:text="@string/num_9"
            android:textSize="28sp"
            android:textColor="#FFFFFF"
            android:background="#505055"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            style="?android:attr/buttonBarButtonStyle"/>

        <Button
            android:id="@+id/btnMultiply"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_weight="1"
            android:text="@string/btn_multiply"
            android:textSize="28sp"
            android:textColor="#FF9500"
            android:background="#3A3A3C"
            android:layout_marginStart="5dp"
            style="?android:attr/buttonBarButtonStyle"/>
    </LinearLayout>

    <!-- Строка 3 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="5dp"
        style="?android:attr/buttonBarStyle">

        <Button
            android:id="@+id/btn4"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_weight="1"
            android:text="@string/num_4"
            android:textSize="28sp"
            android:textColor="#FFFFFF"
            android:background="#505055"
            android:layout_marginEnd="5dp"
            style="?android:attr/buttonBarButtonStyle"/>

        <Button
            android:id="@+id/btn5"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_weight="1"
            android:text="@string/num_5"
            android:textSize="28sp"
            android:textColor="#FFFFFF"
            android:background="#505055"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            style="?android:attr/buttonBarButtonStyle"/>

        <Button
            android:id="@+id/btn6"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_weight="1"
            android:text="@string/num_6"
            android:textSize="28sp"
            android:textColor="#FFFFFF"
            android:background="#505055"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            style="?android:attr/buttonBarButtonStyle"/>

        <Button
            android:id="@+id/btnSub"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_weight="1"
            android:text="@string/btn_subtract"
            android:textSize="28sp"
            android:textColor="#FF9500"
            android:background="#3A3A3C"
            android:layout_marginStart="5dp"
            style="?android:attr/buttonBarButtonStyle"/>
    </LinearLayout>

    <!-- Строка 4 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="5dp"
        style="?android:attr/buttonBarStyle">

        <Button
            android:id="@+id/btn1"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_weight="1"
            android:text="@string/num_1"
            android:textSize="28sp"
            android:textColor="#FFFFFF"
            android:background="#505055"
            android:layout_marginEnd="5dp"
            style="?android:attr/buttonBarButtonStyle"/>

        <Button
            android:id="@+id/btn2"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_weight="1"
            android:text="@string/num_2"
            android:textSize="28sp"
            android:textColor="#FFFFFF"
            android:background="#505055"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            style="?android:attr/buttonBarButtonStyle"/>

        <Button
            android:id="@+id/btn3"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_weight="1"
            android:text="@string/num_3"
            android:textSize="28sp"
            android:textColor="#FFFFFF"
            android:background="#505055"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            style="?android:attr/buttonBarButtonStyle"/>

        <Button
            android:id="@+id/btnAdd"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_weight="1"
            android:text="@string/btn_add"
            android:textSize="28sp"
            android:textColor="#FF9500"
            android:background="#3A3A3C"
            android:layout_marginStart="5dp"
            style="?android:attr/buttonBarButtonStyle"/>
    </LinearLayout>

    <!-- Строка 5 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        style="?android:attr/buttonBarStyle">

        <Button
            android:id="@+id/btn0"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_weight="2"
            android:text="@string/num_0"
            android:textSize="28sp"
            android:textColor="#FFFFFF"
            android:background="#505055"
            android:layout_marginEnd="5dp"
            android:gravity="center"
            android:paddingStart="30dp"
            android:paddingEnd="30dp"
            style="?android:attr/buttonBarButtonStyle"/>

        <Button
            android:id="@+id/btnDot"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_weight="1"
            android:text="@string/btn_dot"
            android:textSize="32sp"
            android:textColor="#FFFFFF"
            android:background="#505055"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            style="?android:attr/buttonBarButtonStyle"/>

        <Button
            android:id="@+id/btnEquals"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_weight="1"
            android:text="@string/btn_equals"
            android:textSize="28sp"
            android:textColor="#FFFFFF"
            android:background="#FF9500"
            android:layout_marginStart="5dp"
            style="?android:attr/buttonBarButtonStyle"/>
    </LinearLayout>

</LinearLayout>